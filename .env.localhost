# Local development (npm run dev). Requests to /api are proxied by Vite to
# VITE_DEV_PROXY_TARGET, so the browser never hits CORS.
VITE_APP_ENV=localhost
VITE_API_BASE_URL=/api
VITE_DEV_PROXY_TARGET=http://office.triangle.net.in:3000
VITE_OAUTH_CLIENT_ID=trigon-web
VITE_MQTT_URL=wss://mqtt.trigon.example.com:8084/mqtt
VITE_USE_MOCK=true
